{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "allowJs": true,
        // Declaration emit, not type checking. The modules are plain ESM with
        // JSDoc written for humans; several of them hand each other
        // loosely-typed manifest and frontmatter objects that no annotation
        // describes honestly, and `checkJs` would report those as errors in a
        // step whose job is to publish `.d.mts` files. Types are still emitted
        // from the JSDoc that is there.
        "checkJs": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmitOnError": true,
        "rootDir": ".",
        "declarationDir": "types"
    },
    "include": [
        "index.mjs",
        "bundle.mjs",
        "deploy.mjs",
        "lang.mjs",
        "manifest.mjs",
        "release.mjs",
        "stage.mjs",
        "text.mjs",
        "config.mjs"
    ]
}
