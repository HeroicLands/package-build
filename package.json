{
    "name": "@heroiclands/package-build",
    "version": "0.5.0",
    "description": "Shared toolchain for building and shipping a HeroicLands Foundry VTT package — manifest, localization, staging, bundle, release and deployment.",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "main": "./index.mjs",
    "types": "./types/index.d.mts",
    "exports": {
        ".": {
            "types": "./types/index.d.mts",
            "import": "./index.mjs"
        },
        "./bundle": {
            "types": "./types/bundle.d.mts",
            "import": "./bundle.mjs"
        },
        "./coverage": {
            "types": "./types/coverage.d.mts",
            "import": "./coverage.mjs"
        },
        "./deploy": {
            "types": "./types/deploy.d.mts",
            "import": "./deploy.mjs"
        },
        "./lang": {
            "types": "./types/lang.d.mts",
            "import": "./lang.mjs"
        },
        "./manifest": {
            "types": "./types/manifest.d.mts",
            "import": "./manifest.mjs"
        },
        "./release": {
            "types": "./types/release.d.mts",
            "import": "./release.mjs"
        },
        "./stage": {
            "types": "./types/stage.d.mts",
            "import": "./stage.mjs"
        },
        "./templates": {
            "types": "./types/templates.d.mts",
            "import": "./templates.mjs"
        },
        "./package.json": "./package.json",
        "./config": {
            "types": "./types/config.d.mts",
            "import": "./config.mjs"
        }
    },
    "files": [
        "bundle.mjs",
        "coverage.mjs",
        "deploy.mjs",
        "index.mjs",
        "lang.mjs",
        "manifest.mjs",
        "templates.mjs",
        "release.mjs",
        "stage.mjs",
        "types",
        "CHANGELOG.md",
        "README.md",
        "bin",
        "config.mjs"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "prepack": "npm run build:types",
        "build:types": "tsc -p tsconfig.dts.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "changeset": "changeset",
        "changeset:check": "changeset status --since=origin/main",
        "prepare": "git config core.hooksPath .githooks || true"
    },
    "dependencies": {
        "@heroiclands/content-build": "^1.0.0",
        "acorn": "^8.18.0",
        "archiver": "^8.0.0",
        "dotenv": "^17.2.3",
        "glob": "^11.0.3",
        "handlebars": "^4.7.9",
        "ssh2-sftp-client": "^12.1.1",
        "typescript": "^6.0.3",
        "yargs": "^18.1.0"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@types/node": "^26.2.0",
        "prettier": "^3.9.6",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "keywords": [
        "foundry-vtt",
        "foundryvtt",
        "heroiclands",
        "sohl",
        "song-of-heroic-lands",
        "build"
    ],
    "homepage": "https://heroiclands.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HeroicLands/package-build.git"
    },
    "bugs": {
        "url": "https://github.com/HeroicLands/package-build/issues"
    },
    "bin": {
        "package-build": "./bin/package-build.mjs"
    }
}
